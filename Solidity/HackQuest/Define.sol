pragma solidity ^0.8.0;

contract Example {
//   Struct = tipe data khusus yang menggabungkan beberapa variabel dengan tipe data berbeda ke dalam satu kelompok.(string dan uint/apapun itu)

  struct Student {
    string name;
    uint256 studentId;
    uint256 grade;
  }
}